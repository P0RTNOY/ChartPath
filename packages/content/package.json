{
  "name": "@chartpath/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "tsx src/validate-cli.ts && tsx src/scenarios/publication/review-pack-cli.ts --check",
    "scenarios:validate": "tsx src/scenarios/validate-cli.ts",
    "scenarios:report": "tsx src/scenarios/report-cli.ts",
    "scenarios:preview": "tsx src/scenarios/preview-cli.ts",
    "scenarios:candidates": "tsx src/scenarios/publication/candidates-cli.ts",
    "reviews:pack": "tsx src/scenarios/publication/review-pack-cli.ts",
    "reviews:check": "tsx src/scenarios/publication/review-pack-cli.ts --check",
    "reviews:verify": "tsx src/scenarios/publication/review-verify-cli.ts",
    "reviewers:governance": "tsx src/scenarios/publication/reviewer-governance-cli.ts",
    "reviewers:keygen": "tsx src/scenarios/publication/reviewer-keygen-cli.ts",
    "release:preflight": "tsx src/scenarios/publication/release-preflight-cli.ts",
    "identity:audit": "tsx src/scenarios/identity-cli.ts"
  },
  "dependencies": {
    "@chartpath/chart-engine": "workspace:*",
    "@chartpath/domain": "workspace:*",
    "@chartpath/historical-data": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
